    "treatments": {
      "type": "silk-treatment-grid",
      "blocks": {
        "t1": {
          "type": "treatment",
          "settings": {
            "title": "The Diagnostic Ritual",
            "eyebrow": "From $150. 45 minutes.",
            "body": "<p>A microscopic evaluation of your scalp and follicles. We look at the biological drivers behind shedding, sensitivity or imbalance, and you go home with a written plan for what to do about it. The $150 comes back off your treatment plan when you book one.</p>"
          }
        },
        "t2": {
          "type": "treatment",
          "settings": {
            "title": "The Cellular Renewal Scalp Facial",
            "eyebrow": "From $350. 1 hour.",
            "body": "<p>A deep scalp detox for buildup, stubborn sebum and micro inflammation, using our hydro dermabrasion machine. Exfoliation, extraction, a targeted nourishment infusion, and a scalp massage that undoes about six months of tension.</p>"
          }
        },
        "t3": {
          "type": "treatment",
          "settings": {
            "title": "The Follicle Infusion Therapy",
            "eyebrow": "From $450. 1 hour.",
            "body": "<p>A regenerative treatment aimed at circulation and dormant roots. Medical grade actives are delivered into the dermis to build density and support stronger growth from the source.</p>"
          }
        },
        "t4": {
          "type": "treatment",
          "settings": {
            "title": "The Comprehensive Hair and Scalp Restoration Program",
            "eyebrow": "16 weeks. $500 deposit, then $200 a week for 15 weeks.",
            "body": "<p>Our full reset. A complete diagnostic scan, then a corrective treatment built for your scalp, delivered weekly for sixteen weeks, alongside a home care routine you actually follow. This is a serious option, and it is not for everybody. The Diagnostic Ritual tells us whether you need it.</p>"
          }
        }
      },
