<section
  id="{{ section.settings.anchor_id | default: 'find-us' }}"
  class="silk-findus-sec"
  style="--silk-findus-pad-top: {{ section.settings.content_padding_top | default: 80 }}px; --silk-findus-pad-bottom: {{ section.settings.content_padding_bottom | default: 80 }}px;"
>
  <div class="silk-wrap silk-findus-in silk-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <p class="silk-findus-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <div class="silk-findus-grid">
      <div class="silk-findus-col">
        <h2>{{ section.settings.heading }}</h2>
        <dl class="silk-findus-dl">
          {%- if section.settings.address != blank -%}
            <div class="silk-findus-row">
              <dt>Address</dt>
              <dd>{{ section.settings.address }}</dd>
            </div>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <div class="silk-findus-row">
              <dt>Phone</dt>
              <dd>{{ section.settings.phone }}</dd>
            </div>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <div class="silk-findus-row">
              <dt>Email</dt>
              <dd>{{ section.settings.email }}</dd>
            </div>
          {%- endif -%}
          {%- if section.settings.instagram != blank -%}
            <div class="silk-findus-row">
              <dt>Instagram</dt>
              <dd>{{ section.settings.instagram }}</dd>
            </div>
          {%- endif -%}
        </dl>
      </div>
      <div class="silk-findus-col">
        {%- if section.blocks.size > 0 -%}
          <h3>{{ section.settings.hours_heading }}</h3>
          <ul class="silk-findus-hours">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="silk-findus-day">{{ block.settings.day }}</span>
                <span>{{ block.settings.hours }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.parking_body != blank -%}
          <h3 class="silk-findus-parking-heading">{{ section.settings.parking_heading }}</h3>
          <p class="silk-findus-parking-body">{{ section.settings.parking_body }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.silk-findus-sec .silk-findus-in{padding-top:var(--silk-findus-pad-top, 80px);padding-bottom:var(--silk-findus-pad-bottom, 80px);}
.silk-findus-eyebrow{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:.6;margin:0;}

.silk-findus-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:56px;margin-top:40px;}
.silk-findus-col:first-child{grid-column:1 / span 5;}
.silk-findus-col:last-child{grid-column:7 / span 6;}

.silk-findus-col h2{
  font-family:var(--font-heading--family);font-weight:320;line-height:1.05;letter-spacing:-.02em;color:#1C1C18;
  font-size:clamp(2.2rem,4vw,3.7rem);margin:0;text-wrap:balance;
}
.silk-findus-col h2 em{font-style:italic;}

.silk-findus-dl{margin:40px 0 0;padding:0;display:grid;gap:16px;}
.silk-findus-row{display:flex;flex-direction:column;gap:4px;border-bottom:1px solid rgba(28,28,24,.15);padding-bottom:12px;}
.silk-findus-row dt{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:.6;margin:0;}
.silk-findus-row dd{font-family:var(--font-body--family);font-size:1.05rem;color:#1C1C18;margin:0;}

.silk-findus-col h3{
  font-family:var(--font-heading--family);font-weight:320;line-height:1.3;color:#1C1C18;
  font-size:clamp(1.1rem,1.6vw,1.28rem);margin:0;
}
.silk-findus-hours{list-style:none;margin:24px 0 0;padding:0;}
.silk-findus-hours li{display:flex;align-items:baseline;justify-content:space-between;gap:24px;border-bottom:1px solid rgba(28,28,24,.15);padding:12px 0;font-family:var(--font-body--family);font-size:14.5px;color:#6f6a63;}
.silk-findus-day{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.1em;text-transform:uppercase;opacity:.7;}

.silk-findus-parking-heading{margin-top:64px;}
.silk-findus-parking-body{margin-top:16px;font-family:var(--font-body--family);font-weight:300;font-size:15.5px;line-height:1.68;color:#6f6a63;max-width:none;}

.silk-wrap{max-width:1280px;margin:0 auto;padding:0 44px;}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}

@media(max-width:900px){
  .silk-wrap{padding-left:24px;padding-right:24px;}
  .silk-findus-grid{grid-template-columns:1fr;gap:40px;}
  .silk-findus-col:first-child,
  .silk-findus-col:last-child{grid-column:1;}
}
@media(prefers-reduced-motion:reduce){
  .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Silk find us",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "find-us"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find us"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Come and <em>see us.</em></p>"
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram handle"
    },
    {
      "type": "header",
      "content": "Opening hours"
    },
    {
      "type": "text",
      "id": "hours_heading",
      "label": "Hours heading",
      "default": "Opening hours"
    },
    {
      "type": "header",
      "content": "Parking"
    },
    {
      "type": "text",
      "id": "parking_heading",
      "label": "Parking heading",
      "default": "Parking"
    },
    {
      "type": "text",
      "id": "parking_body",
      "label": "Parking body"
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "label": "Content padding (top)",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "label": "Content padding (bottom)",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "hours_row",
      "name": "Day",
      "settings": [
        {
          "type": "text",
          "id": "day",
          "label": "Day"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Silk find us",
      "blocks": [
        { "type": "hours_row", "settings": { "day": "Monday" } },
        { "type": "hours_row", "settings": { "day": "Tuesday" } },
        { "type": "hours_row", "settings": { "day": "Wednesday" } },
        { "type": "hours_row", "settings": { "day": "Thursday" } },
        { "type": "hours_row", "settings": { "day": "Friday" } },
        { "type": "hours_row", "settings": { "day": "Saturday" } },
        { "type": "hours_row", "settings": { "day": "Sunday" } }
      ]
    }
  ]
}
{% endschema %}