<section id="{{ section.settings.anchor_id | default: 'about' }}" class="silk-split">
  <div class="silk-imgcol silk-reveal">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600,900,1200,1400' }}
    {%- else -%}
      <img src="{{ 'silk-founder.jpg' | asset_url }}" alt="{{ section.settings.image_alt }}" width="950" height="1187" loading="lazy">
    {%- endif -%}
  </div>
  <div class="silk-txtcol silk-reveal">
    <h2>{{ section.settings.heading }}</h2>
    <div class="silk-body">
      {{ section.settings.body }}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="silk-tlink silk-more" href="{{ section.settings.link_url | default: '#book' }}">{{ section.settings.link_label }} <span class="silk-ar">&rarr;</span></a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.silk-split{display:grid;grid-template-columns:1fr 1fr;min-height:min(88vh,860px);}
.silk-split .silk-imgcol{overflow:hidden;background:#ccc2b6;}
.silk-split .silk-imgcol img{width:100%;height:100%;object-fit:cover;display:block;}
.silk-split .silk-txtcol{background:#4F191D;color:#F0EAE4;display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,6vw,96px);}
.silk-split .silk-txtcol h2{
  color:#F0EAE4;font-family:var(--font-heading--family);font-weight:320;line-height:1;letter-spacing:-.02em;
  font-size:clamp(2.2rem,4vw,3.7rem);max-width:15ch;margin:0;text-wrap:balance;
}
.silk-split .silk-txtcol h2 em{font-style:italic;}
.silk-split .silk-body{margin-top:30px;display:grid;gap:16px;max-width:46ch;font-family:var(--font-body--family);}
.silk-split .silk-body p{color:#e7dbd4;font-size:15.5px;line-height:1.68;max-width:none;}
.silk-split .silk-body p:last-child{font-family:var(--font-accent--family);font-style:italic;font-size:19px;color:#f0ded8;line-height:1.5;}
.silk-split .silk-more{margin-top:34px;color:#F0EAE4;}

.silk-tlink{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;display:inline-flex;gap:.5em;align-items:center;position:relative;padding-bottom:4px;}
.silk-tlink::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:currentColor;transform:scaleX(1);transform-origin:right;transition:transform .4s;}
.silk-tlink:hover::after{transform:scaleX(0);transform-origin:left;}
.silk-tlink .silk-ar{transition:transform .35s;}
.silk-tlink:hover .silk-ar{transform:translateX(4px);}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}

@media(max-width:900px){
  .silk-split{grid-template-columns:1fr;}
  .silk-split .silk-imgcol{min-height:60vh;order:1;}
  .silk-split .silk-txtcol{order:2;}
}
@media(prefers-reduced-motion:reduce){
  .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Silk about split",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "about"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Kelly McColgan, founder of Silk Hair Lab"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>The salon and the <em>science</em>, under one roof.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Silk was started by Kelly McColgan, who has spent 25 years behind the chair. She began at twelve years old in Ireland, trained in Belfast, and cut her way around the world before landing on the Gold Coast.</p><p>Somewhere in those 25 years she got tired of watching women be handed longer, fuller, faker hair when what they really wanted was to feel like themselves again. So she went and studied the science of hair and scalp health.</p><p>So Silk is a clinic, with real answers about why your hair is doing what it is doing. It is also a Friday morning with rollers in and an iced coffee in your hand.</p><p>Both are the same thing, really. Because when your hair feels right, it helps you feel right.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "More about Kelly"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Silk about split"
    }
  ]
}
{% endschema %}
