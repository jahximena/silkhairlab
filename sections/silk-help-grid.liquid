<section
  class="silk-hgrid-sec"
  style="--silk-hgrid-pad-top: {{ section.settings.content_padding_top | default: 80 }}px; --silk-hgrid-pad-bottom: {{ section.settings.content_padding_bottom | default: 80 }}px;"
>
  <div class="silk-wrap silk-hgrid-in silk-reveal">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.blocks.size > 0 -%}
      <div class="silk-hgrid">
        {%- for block in section.blocks -%}
          <div class="silk-hgrid-item" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <p class="silk-hgrid-footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.silk-hgrid-sec .silk-hgrid-in{padding-top:var(--silk-hgrid-pad-top, 80px);padding-bottom:var(--silk-hgrid-pad-bottom, 80px);}
.silk-hgrid-in h2{
  font-family:var(--font-heading--family);font-weight:320;line-height:1.05;letter-spacing:-.02em;color:#1C1C18;
  font-size:clamp(2.2rem,4vw,3.7rem);margin:0;max-width:40ch;text-wrap:balance;
}
.silk-hgrid-in h2 em{font-style:italic;}

.silk-hgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px 48px;margin-top:56px;}
.silk-hgrid-item{border-top:1px solid rgba(28,28,24,.2);padding-top:28px;}
.silk-hgrid-item h3{
  font-family:var(--font-heading--family);font-weight:320;line-height:1.3;color:#1C1C18;
  font-size:clamp(1.1rem,1.6vw,1.28rem);margin:0;
}
.silk-hgrid-item p{margin-top:16px;font-family:var(--font-body--family);font-weight:300;font-size:15.5px;line-height:1.68;color:#6f6a63;max-width:none;}

.silk-hgrid-footnote{margin-top:56px;font-family:var(--font-body--family);font-weight:300;font-size:15.5px;line-height:1.68;color:#6f6a63;max-width:none;}

.silk-wrap{max-width:1440px;margin:0 auto;padding:0 40px;}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}

@media(max-width:900px){
  .silk-wrap{padding-left:16px;padding-right:16px;}
  .silk-hgrid{grid-template-columns:1fr;gap:32px;}
}
@media(prefers-reduced-motion:reduce){
  .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Silk help grid",
  "tag": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Not sure what to <em>book?</em></p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote below the grid"
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "label": "Content padding (top)",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "label": "Content padding (bottom)",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Silk help grid",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}