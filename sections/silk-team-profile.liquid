{%- liquid
  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.image_alt
  assign image_position = section.settings.image_position | default: 'left'
  assign color_scheme = section.settings.color_scheme | default: 'paper'
-%}

<section
  id="{{ section.settings.anchor_id }}"
  class="silk-tprofile silk-tprofile-{{ color_scheme }}{% if image_position == 'right' %} silk-tprofile-imgright{% endif %}"
>
  <div class="silk-tprofile-im silk-reveal">
    {%- if image != blank -%}
      {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600,900,1200,1400', alt: image_alt }}
    {%- else -%}
      <img
        src="{{ 'silk-founder.jpg' | asset_url }}"
        alt="{{ image_alt }}"
        width="1200"
        height="1504"
        loading="lazy"
      >
    {%- endif -%}
  </div>
  <div class="silk-tprofile-body silk-reveal">
    <div
      class="silk-wrap silk-tprofile-in"
      style="--silk-tprofile-pad-top: {{ section.settings.content_padding_top | default: 56 }}px; --silk-tprofile-pad-bottom: {{ section.settings.content_padding_bottom | default: 56 }}px;"
    >
      {%- if section.settings.eyebrow != blank -%}
        <p class="silk-tprofile-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.role != blank -%}
        <h3 class="silk-tprofile-role">{{ section.settings.role }}</h3>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="silk-tprofile-copy">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="silk-tprofile-list-wrap">
          {%- if section.settings.list_heading != blank -%}
            <h3 class="silk-tprofile-list-heading">{{ section.settings.list_heading }}</h3>
          {%- endif -%}
          <ul class="silk-tprofile-list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="silk-tlink silk-tprofile-lk" href="{{ section.settings.link_url | default: '#book' }}">{{ section.settings.link_label }} <span class="silk-ar">&rarr;</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.silk-tprofile{display:grid;grid-template-columns:1fr 1fr;min-height:min(88vh,860px);}
.silk-tprofile.silk-tprofile-imgright .silk-tprofile-im{order:2;}
.silk-tprofile.silk-tprofile-imgright .silk-tprofile-body{order:1;}
.silk-tprofile-im{overflow:hidden;background:#ccc2b6;}
.silk-tprofile-im img{width:100%;height:100%;object-fit:cover;display:block;}
.silk-tprofile-body{display:flex;align-items:center;}
.silk-tprofile-body .silk-tprofile-in{padding-top:var(--silk-tprofile-pad-top, 56px);padding-bottom:var(--silk-tprofile-pad-bottom, 56px);width:100%;}

.silk-tprofile-eyebrow{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:.6;margin:0;}
.silk-tprofile-body h2{
  font-family:var(--font-heading--family);font-weight:320;line-height:1.05;letter-spacing:-.02em;
  font-size:clamp(2.2rem,4vw,3.7rem);margin:16px 0 0;text-wrap:balance;
}
.silk-tprofile-body h2 em{font-style:italic;}
.silk-tprofile-role{font-family:var(--font-heading--family);font-weight:340;font-size:clamp(1.1rem,1.6vw,1.28rem);line-height:1.3;margin-top:16px;opacity:.8;}
.silk-tprofile-copy{margin-top:28px;display:grid;gap:16px;font-family:var(--font-body--family);}
.silk-tprofile-copy p{font-size:15.5px;line-height:1.68;max-width:none;margin:0;}

.silk-tprofile-list-wrap{margin-top:48px;}
.silk-tprofile-list-heading{font-family:var(--font-heading--family);font-weight:320;font-size:1.5rem;margin:0;}
.silk-tprofile-list{list-style:none;margin:24px 0 0;padding:0;}
.silk-tprofile-list li{font-family:var(--font-heading--family);font-weight:340;font-size:1.25rem;padding:16px 0;}

.silk-tprofile-lk{margin-top:40px;}

/* paper variant (light bg) */
.silk-tprofile-paper .silk-tprofile-body{background:#F0EAE4;color:#1C1C18;}
.silk-tprofile-paper .silk-tprofile-body h2{color:#4F191D;}
.silk-tprofile-paper .silk-tprofile-copy p{color:#3a352f;}
.silk-tprofile-paper .silk-tprofile-list-heading{color:#1C1C18;}
.silk-tprofile-paper .silk-tprofile-list li{border-bottom:1px solid rgba(28,28,24,.15);}
.silk-tprofile-paper .silk-tprofile-lk{color:#4F191D;}

/* wine variant (dark bg) */
.silk-tprofile-wine .silk-tprofile-body{background:#4F191D;color:#F0EAE4;}
.silk-tprofile-wine .silk-tprofile-body h2{color:#F0EAE4;}
.silk-tprofile-wine .silk-tprofile-copy p{color:#e7dbd4;}
.silk-tprofile-wine .silk-tprofile-list-heading{color:#F0EAE4;}
.silk-tprofile-wine .silk-tprofile-list li{border-bottom:1px solid rgba(240,234,228,.25);}
.silk-tprofile-wine .silk-tprofile-lk{color:#F0EAE4;}

.silk-tlink{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;display:inline-flex;gap:.5em;align-items:center;position:relative;padding-bottom:4px;}
.silk-tlink::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:currentColor;transform:scaleX(1);transform-origin:right;transition:transform .4s;}
.silk-tlink:hover::after{transform:scaleX(0);transform-origin:left;}
.silk-tlink .silk-ar{transition:transform .35s;}
.silk-tlink:hover .silk-ar{transform:translateX(4px);}

.silk-wrap{max-width:1280px;margin:0 auto;padding:0 44px;}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}

@media(max-width:900px){
  .silk-wrap{padding-left:24px;padding-right:24px;}
  .silk-tprofile{grid-template-columns:1fr;}
  .silk-tprofile-im{min-height:60vh;order:1!important;}
  .silk-tprofile-body{order:2!important;}
}
@media(prefers-reduced-motion:reduce){
  .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Silk team profile",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo alt text"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photo position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper (light)" },
        { "value": "wine", "label": "Wine (dark)" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "label": "Content padding (top)",
      "info": "Space above the eyebrow/name, inside the section.",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "label": "Content padding (bottom)",
      "info": "Space below the list/link, inside the section.",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Founder"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Name",
      "default": "<p>Kelly <em>McColgan</em></p>"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "Founder, hairdresser and trichologist"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Bio"
    },
    {
      "type": "text",
      "id": "list_heading",
      "label": "List heading",
      "default": "Best for"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Book with Kelly"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Silk team profile",
      "blocks": [
        { "type": "list_item" },
        { "type": "list_item" },
        { "type": "list_item" }
      ]
    }
  ]
}
{% endschema %}