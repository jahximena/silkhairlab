<section id="{{ section.settings.anchor_id | default: 'gallery' }}" class="silk-sec silk-gallery-sec">
  <div class="silk-wrap">
    <div class="silk-gal-head silk-reveal">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="silk-gtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="silk-tlink" href="{{ section.settings.link_url | default: '#book' }}" style="color:#4F191D">{{ section.settings.link_label }} <span class="silk-ar">&rarr;</span></a>
      {%- endif -%}
    </div>
  </div>
  <div class="silk-galgrid silk-reveal">
    {%- for block in section.blocks -%}
      <div class="silk-g" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, (min-width: 520px) 50vw, 100vw', widths: '400,600,800,900', alt: block.settings.alt }}
        {%- else -%}
          <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.alt }}" width="800" height="1000" loading="lazy">
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.silk-sec{padding:clamp(84px,11vw,150px) 0;}
.silk-wrap{max-width:1280px;margin:0 auto;padding:0 44px;}
.silk-gal-head{max-width:980px;margin:0 auto clamp(48px,6vw,80px);text-align:center;}
.silk-gal-head h2{
  font-family:var(--font-heading--family);font-weight:320;line-height:1;letter-spacing:-.02em;color:#1C1C18;
  font-size:clamp(2.4rem,5vw,4.4rem);margin:0;text-wrap:balance;
}
.silk-gal-head h2 em{font-style:italic;}
.silk-gal-head .silk-gtext{margin:22px auto 20px;max-width:52ch;font-size:17px;color:#3a352f;font-family:var(--font-body--family);font-weight:300;line-height:1.72;}
.silk-galgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;}
.silk-galgrid .silk-g{overflow:hidden;background:#ccc2b6;aspect-ratio:4/5;}
.silk-galgrid .silk-g img{width:100%;height:100%;object-fit:cover;transition:transform 1.1s cubic-bezier(.2,.7,.2,1);display:block;}
.silk-galgrid .silk-g:hover img{transform:scale(1.05);}

.silk-tlink{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;display:inline-flex;gap:.5em;align-items:center;position:relative;padding-bottom:4px;}
.silk-tlink::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:currentColor;transform:scaleX(1);transform-origin:right;transition:transform .4s;}
.silk-tlink:hover::after{transform:scaleX(0);transform-origin:left;}
.silk-tlink .silk-ar{transition:transform .35s;}
.silk-tlink:hover .silk-ar{transform:translateX(4px);}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}

@media(max-width:900px){
  .silk-wrap{padding-left:24px;padding-right:24px;}
  .silk-galgrid{grid-template-columns:repeat(2,1fr);}
}
@media(max-width:520px){
  .silk-galgrid{grid-template-columns:1fr;}
}
@media(prefers-reduced-motion:reduce){
  .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Silk gallery",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "gallery"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Hair that looks like <em>yours</em>, on a good day.</p>"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Colour, cuts, extensions and treatments, all done in house."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See more on Instagram"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback asset (leave as-is)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Silk gallery",
      "blocks": [
        { "type": "image", "settings": { "alt": "A precision cut in progress", "fallback_asset": "silk-gallery-1.jpg" } },
        { "type": "image", "settings": { "alt": "Two finished colours side by side", "fallback_asset": "silk-gallery-2.jpg" } },
        { "type": "image", "settings": { "alt": "Hand-placed extensions", "fallback_asset": "silk-gallery-3.jpg" } },
        { "type": "image", "settings": { "alt": "Extension wefts matched to tone", "fallback_asset": "silk-gallery-4.jpg" } },
        { "type": "image", "settings": { "alt": "A wet cut being shaped", "fallback_asset": "silk-gallery-5.jpg" } },
        { "type": "image", "settings": { "alt": "Soft waves after a treatment", "fallback_asset": "silk-gallery-6.jpg" } }
      ]
    }
  ]
}
{% endschema %}
