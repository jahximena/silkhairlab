<footer class="silk-footer">
  <div class="silk-wrap">
    <div class="silk-foot">
      <div>
        <div class="silk-fb">{{ section.settings.brand | default: 'Silk' }}</div>
        <div class="silk-sig">{{ section.settings.signature }}</div>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h5>{{ block.settings.heading }}</h5>
          <div class="silk-foot-list">{{ block.settings.items }}</div>
        </div>
      {%- endfor -%}
    </div>
    <div class="silk-fbase">
      <div class="silk-tag">{{ section.settings.tagline }}</div>
      <div class="silk-cp">{{ section.settings.copyright }}</div>
    </div>
  </div>
</footer>

{% stylesheet %}
.silk-wrap{max-width:1280px;margin:0 auto;padding:0 44px;}
.silk-footer{background:#1C1C18;color:#cfc7bf;}
.silk-foot{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:44px;padding-top:clamp(72px,8vw,104px);}
.silk-foot .silk-fb{font-family:var(--font-accent--family);font-style:italic;font-size:42px;color:#F0EAE4;line-height:1;}
.silk-foot .silk-sig{font-family:var(--font-accent--family);font-style:italic;font-size:20px;color:#e7ddd4;margin-top:22px;max-width:24ch;line-height:1.4;}
.silk-foot h5{font-family:var(--font-body--family);font-weight:500;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#8A8E68;margin-bottom:16px;}
.silk-foot-list{font-family:var(--font-body--family);font-weight:300;}
.silk-foot-list ul{list-style:none;display:grid;gap:9px;font-size:14.5px;margin:0;padding:0;}
.silk-foot-list p{font-size:14.5px;margin:0 0 9px;max-width:none;}
.silk-foot-list em{color:#8f877f;font-style:italic;font-size:13px;}
.silk-foot-list a:hover{color:#F0EAE4;}
.silk-fbase{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:clamp(56px,7vw,92px);padding:26px 0;border-top:1px solid rgba(240,234,228,.14);}
.silk-fbase .silk-tag{font-family:var(--font-body--family);font-weight:400;font-size:11px;letter-spacing:.4em;text-transform:uppercase;color:#9a9188;}
.silk-fbase .silk-cp{font-size:12px;color:#83796f;font-family:var(--font-body--family);}

@media(max-width:900px){
  .silk-wrap{padding-left:24px;padding-right:24px;}
  .silk-foot{grid-template-columns:1fr 1fr;gap:34px;}
}
@media(max-width:520px){
  .silk-foot{grid-template-columns:1fr;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Silk footer",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Wordmark",
      "default": "Silk"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line",
      "default": "When your hair feels right, it helps you feel right."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Base tagline",
      "default": "Strong body. Good hair. Good mood."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "Silk Hair Lab · Gold Coast"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading"
        },
        {
          "type": "richtext",
          "id": "items",
          "label": "Items (use the bullet list tool for multiple lines)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Silk footer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Visit",
            "items": "<ul><li>Gold Coast</li><li><em>Full address to confirm</em></li><li><em>Opening hours to confirm</em></li></ul>"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Contact",
            "items": "<ul><li><em>Phone to confirm</em></li><li><em>Email to confirm</em></li></ul>"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Follow",
            "items": "<ul><li><em>Instagram to confirm</em></li></ul>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
