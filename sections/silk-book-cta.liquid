{% liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_font_setting = section.settings.heading_font | default: 'theme_heading'
  case heading_font_setting
    when 'theme_body'
      assign heading_font_var = '--font-body--family'
    when 'theme_accent'
      assign heading_font_var = '--font-accent--family'
    else
      assign heading_font_var = '--font-heading--family'
  endcase
%}

<section id="{{ section.settings.anchor_id | default: 'book' }}" class="silk-sec silk-book">
  <div class="silk-wrap silk-book-in silk-reveal">
    {%- capture heading_style -%}
      --silk-book-heading-font: var({{ heading_font_var }});
      --silk-book-heading-size: {{ section.settings.heading_size_desktop | default: 4.6 }}rem;
      --silk-book-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 2.6 }}rem;
    {%- endcapture -%}
    {%- case heading_tag -%}
      {%- when 'h1' -%}
        <h1 class="silk-book-heading" style="{{ heading_style }}">{{ section.settings.heading }}</h1>
      {%- when 'h3' -%}
        <h3 class="silk-book-heading" style="{{ heading_style }}">{{ section.settings.heading }}</h3>
      {%- when 'h4' -%}
        <h4 class="silk-book-heading" style="{{ heading_style }}">{{ section.settings.heading }}</h4>
      {%- else -%}
        <h2 class="silk-book-heading" style="{{ heading_style }}">{{ section.settings.heading }}</h2>
    {%- endcase -%}
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="silk-cta">
        <a
          class="silk-btn silk-btn-paper"
          href="{{ section.settings.button_link | default: '#book' }}"
          style="
            --silk-btn-bg: {{ section.settings.button_bg | default: '#ffffff' }};
            --silk-btn-bg-hover: {{ section.settings.button_bg_hover | default: '#F0EAE4' }};
            --silk-btn-text: {{ section.settings.button_text_color | default: '#4F191D' }};
            --silk-btn-text-hover: {{ section.settings.button_text_color_hover | default: '#4F191D' }};
          "
        >{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <p class="silk-call">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.silk-sec{padding:clamp(84px,11vw,150px) 0;}
.silk-wrap{max-width:1280px;margin:0 auto;padding:0 44px;}
.silk-book{background:#4F191D;color:#F0EAE4;text-align:center;}
.silk-book-in{max-width:820px;margin:0 auto;}
.silk-book .silk-book-heading{
  font-family:var(--silk-book-heading-font, var(--font-heading--family));font-weight:320;line-height:1;letter-spacing:-.02em;color:#F0EAE4;
  font-size:var(--silk-book-heading-size, 4.6rem);margin:0;text-wrap:balance;
}
.silk-book .silk-book-heading em{font-style:italic;}
.silk-book p{color:#ecdfd9;font-family:var(--font-body--family);font-weight:300;font-size:clamp(1.05rem,1.7vw,1.28rem);margin:26px auto 0;max-width:44ch;}
.silk-book .silk-cta{margin-top:44px;}
.silk-book .silk-call{margin-top:24px;font-size:14px;color:#d8bcb6;}

.silk-btn{display:inline-flex;align-items:center;gap:.6em;font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:17px 34px;transition:.35s;cursor:pointer;border:1px solid transparent;}
.silk-btn-paper{background:var(--silk-btn-bg, #ffffff);color:var(--silk-btn-text, #4F191D);}
.silk-btn-paper:hover{background:var(--silk-btn-bg-hover, #F0EAE4);color:var(--silk-btn-text-hover, #4F191D);}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}
@media(max-width:900px){
  .silk-wrap{padding-left:24px;padding-right:24px;}
  .silk-book .silk-book-heading{font-size:var(--silk-book-heading-size-mobile, 2.6rem);}
}
@media(prefers-reduced-motion:reduce){ .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;} }
{% endstylesheet %}

{% schema %}
{
  "name": "Silk booking CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "book"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Come and <em>see</em> us.</p>"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body text",
      "default": "Whether you have been worried about your hair for years or you just want a really good blow wave, start with a conversation."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book an appointment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Or give us a call. We would rather talk to you than take a form."
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "Changes the HTML tag used for SEO/accessibility. Doesn't affect the visual size.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "theme_heading", "label": "Theme heading font (Fraunces)" },
        { "value": "theme_body", "label": "Theme body font (Poppins)" },
        { "value": "theme_accent", "label": "Theme accent font (italic Fraunces)" }
      ],
      "default": "theme_heading"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 1.5,
      "max": 8,
      "step": 0.1,
      "unit": "rem",
      "default": 4.6
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 1.2,
      "max": 5,
      "step": 0.1,
      "unit": "rem",
      "default": 2.6
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Background color (hover)",
      "default": "#F0EAE4"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#4F191D"
    },
    {
      "type": "color",
      "id": "button_text_color_hover",
      "label": "Text color (hover)",
      "default": "#4F191D"
    }
  ],
  "presets": [
    { "name": "Silk booking CTA" }
  ]
}
{% endschema %}
