<section id="{{ section.settings.anchor_id | default: 'book' }}" class="silk-sec silk-book">
  <div class="silk-wrap silk-book-in silk-reveal">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="silk-cta"><a class="silk-btn silk-btn-paper" href="{{ section.settings.button_link | default: '#book' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <p class="silk-call">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.silk-sec{padding:clamp(84px,11vw,150px) 0;}
.silk-wrap{max-width:1280px;margin:0 auto;padding:0 44px;}
.silk-book{background:#4F191D;color:#F0EAE4;text-align:center;}
.silk-book-in{max-width:820px;margin:0 auto;}
.silk-book h2{
  font-family:var(--font-heading--family);font-weight:320;line-height:1;letter-spacing:-.02em;color:#F0EAE4;
  font-size:clamp(2.8rem,7vw,5.6rem);margin:0;text-wrap:balance;
}
.silk-book h2 em{font-style:italic;}
.silk-book p{color:#ecdfd9;font-family:var(--font-body--family);font-weight:300;font-size:clamp(1.05rem,1.7vw,1.28rem);margin:26px auto 0;max-width:44ch;}
.silk-book .silk-cta{margin-top:44px;}
.silk-book .silk-call{margin-top:24px;font-size:14px;color:#d8bcb6;}

.silk-btn{display:inline-flex;align-items:center;gap:.6em;font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:17px 34px;transition:.35s;cursor:pointer;border:1px solid transparent;}
.silk-btn-paper{background:#F0EAE4;color:#4F191D;}
.silk-btn-paper:hover{background:#fff;}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}
@media(max-width:900px){ .silk-wrap{padding-left:24px;padding-right:24px;} }
@media(prefers-reduced-motion:reduce){ .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;} }
{% endstylesheet %}

{% schema %}
{
  "name": "Silk booking CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "book"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Come and <em>see</em> us.</p>"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body text",
      "default": "Whether you have been worried about your hair for years or you just want a really good blow wave, start with a conversation."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book an appointment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Or give us a call. We would rather talk to you than take a form."
    }
  ],
  "presets": [
    { "name": "Silk booking CTA" }
  ]
}
{% endschema %}
