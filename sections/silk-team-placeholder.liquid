<section
  class="silk-tplaceholder"
  style="--silk-tplaceholder-pad-top: {{ section.settings.content_padding_top | default: 80 }}px; --silk-tplaceholder-pad-bottom: {{ section.settings.content_padding_bottom | default: 80 }}px;"
>
  {%- for block in section.blocks -%}
    {%- assign is_even = false -%}
    {%- assign remainder = forloop.index | modulo: 2 -%}
    {%- if remainder == 0 -%}
      {%- assign is_even = true -%}
    {%- endif -%}
    <div
      class="silk-wrap silk-tplaceholder-row{% if is_even %} silk-tplaceholder-reverse{% endif %}{% if forloop.first == false %} silk-tplaceholder-divider{% endif %} silk-reveal"
      {{ block.shopify_attributes }}
    >
      <div class="silk-tplaceholder-head">
        <h2>{{ block.settings.heading }}</h2>
        {%- if block.settings.subheading != blank -%}
          <h3 class="silk-tplaceholder-sub">{{ block.settings.subheading }}</h3>
        {%- endif -%}
      </div>
      <div class="silk-tplaceholder-copy-col">
        {%- if block.settings.body != blank -%}
          <div class="silk-tplaceholder-copy">{{ block.settings.body }}</div>
        {%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <a class="silk-tlink silk-tplaceholder-lk" href="{{ block.settings.link_url | default: '#book' }}">{{ block.settings.link_label }} <span class="silk-ar">&rarr;</span></a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>

{% stylesheet %}
.silk-tplaceholder{background:#4F191D;color:#F0EAE4;}
.silk-tplaceholder .silk-tplaceholder-row{display:grid;grid-template-columns:repeat(12,1fr);gap:48px;padding-top:var(--silk-tplaceholder-pad-top, 80px);padding-bottom:var(--silk-tplaceholder-pad-bottom, 80px);align-items:start;}
.silk-tplaceholder-row.silk-tplaceholder-divider{border-top:1px solid rgba(240,234,228,.2);}
.silk-tplaceholder-head{grid-column:1 / span 5;}
.silk-tplaceholder-copy-col{grid-column:7 / span 6;}
.silk-tplaceholder-row.silk-tplaceholder-reverse .silk-tplaceholder-head{grid-column:8 / span 5;order:2;}
.silk-tplaceholder-row.silk-tplaceholder-reverse .silk-tplaceholder-copy-col{grid-column:1 / span 6;grid-row:1;order:1;}

.silk-tplaceholder-head h2{
  font-family:var(--font-heading--family);font-weight:320;line-height:1.05;letter-spacing:-.02em;color:#F0EAE4;
  font-size:clamp(2.2rem,4vw,3.7rem);margin:0;text-wrap:balance;
}
.silk-tplaceholder-sub{font-family:var(--font-heading--family);font-weight:340;font-size:clamp(1.1rem,1.6vw,1.28rem);line-height:1.3;margin-top:16px;opacity:.8;}
.silk-tplaceholder-copy{display:grid;gap:16px;font-family:var(--font-body--family);}
.silk-tplaceholder-copy p{color:rgba(240,234,228,.75);font-size:15.5px;line-height:1.68;max-width:none;margin:0;}
.silk-tplaceholder-lk{margin-top:32px;color:#F0EAE4;}

.silk-tlink{font-family:var(--font-body--family);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;display:inline-flex;gap:.5em;align-items:center;position:relative;padding-bottom:4px;}
.silk-tlink::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:currentColor;transform:scaleX(1);transform-origin:right;transition:transform .4s;}
.silk-tlink:hover::after{transform:scaleX(0);transform-origin:left;}
.silk-tlink .silk-ar{transition:transform .35s;}
.silk-tlink:hover .silk-ar{transform:translateX(4px);}

.silk-wrap{max-width:1440px;margin:0 auto;padding:0 40px;}

.silk-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease;}
.silk-reveal.silk-in{opacity:1;transform:none;}

@media(max-width:900px){
  .silk-wrap{padding-left:16px;padding-right:16px;}
  .silk-tplaceholder .silk-tplaceholder-row{grid-template-columns:1fr;gap:24px;padding:56px 0;}
  .silk-tplaceholder-head,
  .silk-tplaceholder-copy-col,
  .silk-tplaceholder-row.silk-tplaceholder-reverse .silk-tplaceholder-head,
  .silk-tplaceholder-row.silk-tplaceholder-reverse .silk-tplaceholder-copy-col{grid-column:1;order:initial;}
}
@media(prefers-reduced-motion:reduce){
  .silk-reveal{opacity:1!important;transform:none!important;transition:none!important;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Silk team placeholder",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "content_padding_top",
      "label": "Row padding (top)",
      "info": "Space above each person's name, applied to every row.",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "label": "Row padding (bottom)",
      "info": "Space below each person's link, applied to every row.",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Placeholder profile",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Name / placeholder title",
          "default": "Person One"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Short bios. Long appointments."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body copy",
          "default": "<p>Every stylist at Silk has their own chair, their own regulars and their own thing they are known for. This profile is on its way.</p><p>Until then, tell us what you need when you book and we will put you with the right person.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Get in touch"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Silk team placeholder",
      "blocks": [
        { "type": "person" },
        { "type": "person" },
        { "type": "person" }
      ]
    }
  ]
}
{% endschema %}
